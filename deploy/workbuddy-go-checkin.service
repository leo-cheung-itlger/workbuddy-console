# Keep the existing timer/service name for in-place upgrades; credentials live in Python only.
[Unit]
Description=Unified WorkBuddy account daily check-in
Requires=workbuddy-python.service
After=workbuddy-python.service network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/workbuddy-console/current/app/checkin_task.py
EnvironmentFile=-/etc/workbuddy-console.env
UMask=0077
TimeoutStartSec=10min
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=64M
